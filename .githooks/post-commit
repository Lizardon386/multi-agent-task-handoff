#!/bin/sh
# 提交后：1) 把当前 HEAD 同步到 $AGENT_CONFIG/sync-paths 里的安装目录；
# 2) 自动 push（不 force），失败重试一次并提示。
# 只在 commit 时跑，不常驻；push 失败不阻塞原提交。

repo=$(git rev-parse --show-toplevel) || exit 0

# 注册表统一放 $AGENT_CONFIG/sync-paths；旧位置 $repo/.skill-sync-paths 一次性迁移。
if [ -n "${AGENT_CONFIG:-}" ]; then cfg_dir=$AGENT_CONFIG
elif [ -n "${APPDATA:-}" ]; then cfg_dir=$(printf '%s' "$APPDATA/multi-agent-task-handoff" | sed 's|\\|/|g')
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then cfg_dir=$XDG_CONFIG_HOME/multi-agent-task-handoff
else cfg_dir=$HOME/.config/multi-agent-task-handoff
fi
sync_paths=$cfg_dir/sync-paths
if [ ! -f "$sync_paths" ] && [ -f "$repo/.skill-sync-paths" ]; then
  mkdir -p "$cfg_dir" 2>/dev/null || true
  cp "$repo/.skill-sync-paths" "$sync_paths" 2>/dev/null && rm -f "$repo/.skill-sync-paths"
fi

if [ -f "$repo/install.sh" ] && command -v sh >/dev/null 2>&1; then
  # --syncall 幂等：只补落后的副本，已最新的直接跳过。
  # 所以被打断也不留后患 —— 下次提交会再跑一遍，自动补齐。
  # 清掉钩子注入的 GIT_* 变量，避免 install.sh 误判仓库状态。
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
    sh "$repo/install.sh" --syncall </dev/null \
    || printf '%s\n' "副本同步未全部成功；手动补齐: sh \"$repo/install.sh\" --syncall" >&2
elif [ -f "$sync_paths" ]; then
  # 兜底：没有 install.sh 时按清单逐份解包（用 fd 3 读，避免循环体吃掉清单剩余行）
  head_commit=$(git -C "$repo" rev-parse HEAD)
  while IFS= read -r line <&3; do
    case "$line" in ''|'#'*) continue ;; esac
    path=$(printf '%s' "$line" | sed 's/[[:space:]]*$//')
    [ -d "$(dirname "$path")" ] || continue
    rm -rf "$path" && mkdir -p "$path" || { echo "skill 同步失败 -> $path" >&2; continue; }
    git -C "$repo" archive HEAD | tar -x -C "$path" </dev/null || true
    date=$(git -C "$repo" log -1 --format=%cI)
    printf 'commit=%s\ndate=%s\nsource=%s\n' "$head_commit" "$date" "$repo" > "$path/.skill-version"
    echo "skill synced -> $path ($head_commit)"
  done 3< "$sync_paths"
fi

# amend / merge / rebase 期间不自动加提交，也不自动 push
case "$(git -C "$repo" reflog -1 --format=%gs 2>/dev/null || true)" in
  *amend*) exit 0 ;;
esac
for f in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -f "$(git -C "$repo" rev-parse --git-path "$f" 2>/dev/null)" ] && exit 0
done

if [ "${SKIP_AUTO_PUSH:-}" != "1" ]; then
  if git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    local_head=$(git -C "$repo" rev-parse HEAD)
    upstream_head=$(git -C "$repo" rev-parse '@{u}' 2>/dev/null || true)
    if [ "$local_head" != "$upstream_head" ]; then
      if ! git -C "$repo" push >/dev/null 2>&1; then
        sleep 2
        git -C "$repo" push >/dev/null 2>&1 || {
          printf '%s\n' "自动 push 失败；请手动运行: git -C \"$repo\" push" >&2
          exit 0
        }
      fi
      remote_head=$(git -C "$repo" ls-remote origin HEAD 2>/dev/null | awk 'NR==1{print $1}')
      if [ -n "$remote_head" ] && [ "$remote_head" != "$local_head" ]; then
        printf '%s\n' "push 后远端 HEAD 与本地不一致，请检查" >&2
      else
        echo "已自动 push: $(git -C "$repo" rev-parse --short HEAD)"
      fi
    fi
  fi
fi

exit 0
