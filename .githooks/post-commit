#!/bin/sh
# 可选加速：提交后把当前 HEAD 同步到 $AGENT_CONFIG/sync-paths 里的安装目录。
# 不自动 push。副本同步与 push 由 --suspend 显式执行（见 SKILL.md）；
# 本钩子跑不到也不影响正确性；只在 commit 时跑，不常驻。

repo=$(git rev-parse --show-toplevel) || exit 0

# 注册表统一放 $AGENT_CONFIG/sync-paths；旧位置 $repo/.skill-sync-paths 一次性迁移。
if [ -n "${AGENT_CONFIG:-}" ]; then cfg_dir=$AGENT_CONFIG
elif [ -n "${APPDATA:-}" ]; then cfg_dir=$(printf '%s' "$APPDATA/multi-agent-task-handoff" | sed 's|\\|/|g')
elif [ -n "${XDG_CONFIG_HOME:-}" ]; then cfg_dir=$XDG_CONFIG_HOME/multi-agent-task-handoff
else cfg_dir=$HOME/.config/multi-agent-task-handoff
fi
sync_paths=$cfg_dir/sync-paths
if [ ! -f "$sync_paths" ] && [ -f "$repo/.skill-sync-paths" ]; then
  mkdir -p "$cfg_dir" 2>/dev/null || true
  cp "$repo/.skill-sync-paths" "$sync_paths" 2>/dev/null && rm -f "$repo/.skill-sync-paths"
fi

if [ -f "$repo/scripts/handoff.sh" ] && command -v sh >/dev/null 2>&1; then
  # --syncall 幂等：只补落后的副本，已最新的直接跳过。
  # 清掉钩子注入的 GIT_* 变量，避免 install.sh 误判仓库状态。
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
    sh "$repo/scripts/handoff.sh" --syncall </dev/null \
    || printf '%s\n' "副本同步未全部成功；手动补齐: sh \"$repo/scripts/handoff.sh\" --syncall" >&2
elif [ -f "$sync_paths" ]; then
  # 兜底：没有 install.sh 时按清单逐份解包（用 fd 3 读，避免循环体吃掉清单剩余行）
  head_commit=$(git -C "$repo" rev-parse HEAD)
  while IFS= read -r line <&3; do
    case "$line" in ''|'#'*) continue ;; esac
    path=$(printf '%s' "$line" | sed 's/[[:space:]]*$//')
    [ -d "$(dirname "$path")" ] || continue
    rm -rf "$path" && mkdir -p "$path" || { echo "skill 同步失败 -> $path" >&2; continue; }
    git -C "$repo" archive HEAD | tar -x -C "$path" </dev/null || true
    date=$(git -C "$repo" log -1 --format=%cI)
    printf 'commit=%s\ndate=%s\nsource=%s\n' "$head_commit" "$date" "$repo" > "$path/.skill-version"
    echo "skill synced -> $path ($head_commit)"
  done 3< "$sync_paths"
fi

# 同步与 push 由 --suspend 显式执行；本钩子只作可选加速。
exit 0
